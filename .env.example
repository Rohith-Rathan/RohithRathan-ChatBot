# Copy this file to .env and fill in real values. Never commit .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Google Drive ---
GDRIVE_FOLDER_ID=your-drive-folder-id
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- Learner identity (used by Claude to decide which emails are yours) ---
LEARNER_NAME=Your Full Name
LEARNER_EMAIL=you@example.com

# --- Dashboard API ---
DASHBOARD_BASE_URL=https://trainer-central-assigments-api.onrender.com
# Optional: leave blank if the API does not require a key
DASHBOARD_API_KEY=
# Sender name shown on the dashboard (2-100 chars, keep it identical on every run)
DASHBOARD_SENDER=Your Full Name

# --- Local state ---
DB_PATH=data/processed.db
LOG_DIR=logs
